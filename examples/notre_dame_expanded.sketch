# -----------------------------------------------------------------------------
# SECTION: BUILDING STRUCTURE OUTLINE
# Description: The primary silhouette of the cathedral establishing the overall
# mass and proportions. This outline defines the iconic twin-tower facade shape
# before any interior details are added. Heavy traced lines create the dominant
# structural frame that anchors the entire composition.
# -----------------------------------------------------------------------------

# Key structural coordinates
let outline_ground : number = 200
let outline_top : number = 20
let outline_left : number = 30
let outline_right : number = 170
let tower_inner_left : number = 70
let tower_inner_right : number = 130
let mid_section_top : number = 40
let tower_cap_height : number = 25
let buttress_offset : number = 5

# LEFT TOWER OUTLINE - outer silhouette
trace stroke from (outline_left, outline_ground) to (outline_left, outline_top)
trace stroke from (outline_left, outline_top) to (tower_inner_left, outline_top)
trace stroke from (tower_inner_left, outline_top) to (tower_inner_left, mid_section_top)

# Left tower cap - horizontal closure at top
trace stroke from (outline_left, tower_cap_height) to (tower_inner_left, tower_cap_height)

# Left tower buttress hint - slight setback suggesting depth
trace stroke from (outline_left + buttress_offset, outline_ground) to (outline_left + buttress_offset, 120)

# RIGHT TOWER OUTLINE - outer silhouette  
trace stroke from (outline_right, outline_ground) to (outline_right, outline_top)
trace stroke from (outline_right, outline_top) to (tower_inner_right, outline_top)
trace stroke from (tower_inner_right, outline_top) to (tower_inner_right, mid_section_top)

# Right tower cap - horizontal closure at top
trace stroke from (tower_inner_right, tower_cap_height) to (outline_right, tower_cap_height)

# Right tower buttress hint - slight setback suggesting depth
trace stroke from (outline_right - buttress_offset, outline_ground) to (outline_right - buttress_offset, 120)

# CENTRAL SECTION OUTLINE - connecting the towers
trace stroke from (tower_inner_left, mid_section_top) to (tower_inner_right, mid_section_top)

# Central section lower tier - gallery level
let gallery_level : number = 60
trace stroke from (tower_inner_left, gallery_level) to (tower_inner_right, gallery_level)

# BASE OUTLINE - ground level facade width
trace stroke from (outline_left, outline_ground) to (outline_right, outline_ground)

# Base plinth line - subtle elevation above ground
let plinth_height : number = 195
trace stroke from (outline_left, plinth_height) to (outline_right, plinth_height)

# SPIRE OUTLINE - central spire rising from middle section
let spire_base_left : vec = (90, mid_section_top)
let spire_base_right : vec = (110, mid_section_top)
let spire_apex : vec = (100, 0)

trace stroke from spire_base_left to spire_apex
trace stroke from spire_base_right to spire_apex

# Spire base connection to roofline
trace stroke from (tower_inner_left, mid_section_top) to spire_base_left
trace stroke from spire_base_right to (tower_inner_right, mid_section_top)

# Spire intermediate detail - horizontal band suggesting structure
let spire_band : number = 20
trace stroke from (95, spire_band) to (105, spire_band)