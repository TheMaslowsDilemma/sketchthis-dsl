let frontRightVein5 : sketch = stroke from (134, 50) to (152, 40) via [(144, 46)]

trace [frontRightMainVein, frontRightVein2, frontRightVein3, frontRightVein4, frontRightVein5]

# Front Right shading
scribble dash at (130, 48)
scribble dash at (135, 44)
scribble dash at (140, 40)
scribble dash at (145, 36)
scribble dash at (148, 32)
scribble dash at (125, 52)
scribble dash at (132, 46)
scribble dash at (138, 42)
scribble dash at (143, 38)

# Front Center Petal - the focal point
let frontCenterLeftEdge : sketch = stroke from (88, 62) to (78, 22) via [(82, 48), (78, 35)]
let frontCenterTipLeft : sketch = stroke from (78, 22) to (90, 12) via [(82, 16), (86, 13)]
let frontCenterTipPeak : sketch = stroke from (90, 12) to (100, 10) via [(94, 10), (97, 9)]
let frontCenterTipRight : sketch = stroke from (100, 10) to (110, 12) via [(103, 9), (106, 10)]
