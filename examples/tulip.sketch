# ═══════════════════════════════════════════════════════════════
# EXTRAORDINARY TULIP - A Pen Plotter Masterpiece
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# BASE COORDINATES - The tulip rises from lower center
# ─────────────────────────────────────────────────────────────────
let stemBase : vec = (100, 180)
let stemTop : vec = (100, 65)
let flowerCenter : vec = (100, 55)

# ═══════════════════════════════════════════════════════════════
# THE STEM - Graceful organic curves with slight bend
# ═══════════════════════════════════════════════════════════════

# Main stem - slightly curved for natural feel
let stemLeft : sketch = stroke from (97, 180) to (96, 65) via [(94, 130), (95, 90)]
let stemRight : sketch = stroke from (103, 180) to (104, 65) via [(106, 130), (105, 90)]

# Stem detail lines - subtle internal texture
let stemDetail1 : sketch = stroke from (99, 175) to (99, 70) via [(98, 120)]
let stemDetail2 : sketch = stroke from (101, 175) to (101, 70) via [(102, 120)]

draw [stemLeft, stemRight]
trace [stemDetail1, stemDetail2]

# ═══════════════════════════════════════════════════════════════
# LEFT LEAF - Elegant sweeping curve
# ═══════════════════════════════════════════════════════════════

let leafLeftAttach : vec = (98, 140)

# Left leaf outer edge - dramatic sweep
let leafLeftOuter : sketch = stroke from leafLeftAttach to (25, 115) via [(70, 125), (45, 118)]
let leafLeftTip : sketch = stroke from (25, 115) to (20, 110) via [(22, 112)]
let leafLeftReturn : sketch = stroke from (20, 110) to (95, 135) via [(35, 108), (60, 115), (80, 125)]

# Left leaf central vein
let leafLeftVein : sketch = stroke from (95, 137) to (25, 113) via [(65, 120), (45, 115)]

# Left leaf secondary veins
let leafLeftVein2 : sketch = stroke from (80, 128) to (50, 118) via [(65, 122)]
let leafLeftVein3 : sketch = stroke from (70, 125) to (40, 114) via [(55, 118)]
let leafLeftVein4 : sketch = stroke from (60, 122) to (35, 112) via [(48, 116)]

draw [leafLeftOuter, leafLeftTip, leafLeftReturn]
trace [leafLeftVein, leafLeftVein2, leafLeftVein3, leafLeftVein4]

# Leaf texture - delicate shading dashes
scribble dash at (75, 123)
scribble dash at (65, 120)
scribble dash at (55, 117)
scribble dash at (45, 114)
scribble dash at (35, 111)
scribble dash at (70, 126)
scribble dash at (60, 123)
scribble dash at (50, 119)

# ═══════════════════════════════════════════════════════════════
# RIGHT LEAF - Mirror elegance with unique character
# ═══════════════════════════════════════════════════════════════

let leafRightAttach : vec = (102, 145)

# Right leaf outer edge
let leafRightOuter : sketch = stroke from leafRightAttach to (175, 130) via [(130, 138), (155, 135)]
let leafRightTip : sketch = stroke from (175, 130) to (182, 125) via [(179, 127)]
let leafRightReturn : sketch = stroke from (182, 125) to (105, 142) via [(165, 122), (140, 128), (120, 135)]

# Right leaf central vein
let leafRightVein : sketch = stroke from (105, 143) to (178, 127) via [(135, 135), (158, 130)]

# Right leaf secondary veins
let leafRightVein2 : sketch = stroke from (120, 138) to (150, 132) via [(135, 135)]
let leafRightVein3 : sketch = stroke from (135, 136) to (160, 130) via [(148, 133)]
let leafRightVein4 : sketch = stroke from (150, 133) to (170, 128) via [(160, 130)]

draw [leafRightOuter, leafRightTip, leafRightReturn]
trace [leafRightVein, leafRightVein2, leafRightVein3, leafRightVein4]

# Right leaf texture dashes
scribble dash at (125, 136)
scribble dash at (140, 134)
scribble dash at (155, 131)
scribble dash at (165, 129)
scribble dash at (130, 138)
scribble dash at (145, 135)
scribble dash at (160, 132)

# ═══════════════════════════════════════════════════════════════
# THE BLOOM - Six Magnificent Petals
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# BACK PETALS (drawn first, partially obscured)
# ─────────────────────────────────────────────────────────────────

# Back Left Petal
let backLeftPetalLeft : sketch = stroke from (85, 60) to (60, 15) via [(70, 45), (58, 30)]
let backLeftPetalTip : sketch = stroke from (60, 15) to (72, 8) via [(64, 10), (68, 8)]
let backLeftPetalRight : sketch = stroke from (72, 8) to (92, 55) via [(78, 15), (88, 35)]

draw [backLeftPetalLeft, backLeftPetalTip, backLeftPetalRight]

# Back Left Petal veins
let backLeftVein1 : sketch = stroke from (88, 58) to (66, 12) via [(75, 38), (68, 22)]
let backLeftVein2 : sketch = stroke from (82, 55) to (63, 18) via [(72, 38)]
let backLeftVein3 : sketch = stroke from (78, 52) to (62, 22) via [(70, 38)]

trace [backLeftVein1, backLeftVein2, backLeftVein3]

# Back Right Petal
let backRightPetalLeft : sketch = stroke from (108, 55) to (128, 8) via [(112, 35), (122, 15)]
let backRightPetalTip : sketch = stroke from (128, 8) to (140, 15) via [(132, 8), (136, 10)]
let backRightPetalRight : sketch = stroke from (140, 15) to (115, 60) via [(142, 30), (130, 45)]

