let frontLeftVein2 : sketch = stroke from (85, 58) to (50, 25) via [(65, 42)]
let frontLeftVein3 : sketch = stroke from (78, 55) to (48, 30) via [(62, 44)]
let frontLeftVein4 : sketch = stroke from (72, 52) to (47, 35) via [(58, 45)]
