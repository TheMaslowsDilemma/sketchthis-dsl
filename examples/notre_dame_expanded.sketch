# -----------------------------------------------------------------------------
# SECTION: MAIN FACADE BASE
# Description: The lower horizontal foundation of the cathedral facade,
# establishing the wide rectangular base from which the towers rise.
# Strong horizontal lines ground the composition. Includes the stepped
# platform, buttress hints, and the subtle depth of the foundation stones.
# -----------------------------------------------------------------------------

let facade_base_y : number = 200
let facade_left : number = 30
let facade_right : number = 170
let facade_center : number = 100

# Foundation coordinates
let ground_y : number = 210
let plinth_y : number = 205

# Ground line - the lowest visible element
trace stroke from (facade_left - 5, ground_y) to (facade_right + 5, ground_y)

# Plinth step - first raised platform
trace stroke from (facade_left - 3, plinth_y) to (facade_right + 3, plinth_y)

# Base foundation line - main horizontal datum
trace stroke from (facade_left, facade_base_y) to (facade_right, facade_base_y)

# Portal level platform
trace stroke from (facade_left, 195) to (facade_right, 195)

# Vertical returns connecting foundation levels (left side)
trace stroke from (facade_left - 5, ground_y) to (facade_left - 3, plinth_y)
trace stroke from (facade_left - 3, plinth_y) to (facade_left, facade_base_y)

# Vertical returns connecting foundation levels (right side)
trace stroke from (facade_right + 5, ground_y) to (facade_right + 3, plinth_y)
trace stroke from (facade_right + 3, plinth_y) to (facade_right, facade_base_y)

# Subtle stone course lines in foundation (horizontal joints)
draw stroke from (facade_left, 208) to (facade_right, 208)
draw stroke from (facade_left, 203) to (facade_right, 203)

# Buttress projection hints at corners (left)
let buttress_depth : number = 4
trace stroke from (facade_left, ground_y) to (facade_left, 195)
trace stroke from (facade_left + buttress_depth, ground_y) to (facade_left + buttress_depth, 195)
draw stroke from (facade_left, 207) to (facade_left + buttress_depth, 207)
draw stroke from (facade_left, 202) to (facade_left + buttress_depth, 202)

# Buttress projection hints at corners (right)
trace stroke from (facade_right, ground_y) to (facade_right, 195)
trace stroke from (facade_right - buttress_depth, ground_y) to (facade_right - buttress_depth, 195)
draw stroke from (facade_right - buttress_depth, 207) to (facade_right, 207)
draw stroke from (facade_right - buttress_depth, 202) to (facade_right, 202)

# Central axis marker - subtle emphasis toward vanishing point
let axis_left : number = 98
let axis_right : number = 102
draw stroke from (axis_left, ground_y) to (axis_left, 195)
draw stroke from (axis_right, ground_y) to (axis_right, 195)

# Stone texture in foundation - light scribble shading
let shade_y1 : number = 207
let shade_y2 : number = 203
scribble dash at (40, shade_y1)
scribble dash at (55, shade_y1)
scribble dash at (70, shade_y2)
scribble dash at (85, shade_y1)
scribble dash at (115, shade_y1)
scribble dash at (130, shade_y2)
scribble dash at (145, shade_y1)
scribble dash at (160, shade_y2)

# Shadow beneath plinth overhang (creates depth)
let shadow_base : sketch = [
  dash at (35, 206),
  dash at (50, 206),
  dash at (65, 206),
  dash at (80, 206),
  dash at (95, 206),
  dash at (105, 206),
  dash at (120, 206),
  dash at (135, 206),
  dash at (150, 206),
  dash at (165, 206)
]
scribble shadow_base

# Worn stone texture at ground level
let ground_texture : sketch = [
  dash at (32, 209),
  dash at (48, 209),
  dash at (78, 209),
  dash at (122, 209),
  dash at (152, 209),
  dash at (168, 209)
]
scribble ground_texture

# -----------------------------------------------------------------------------
# SECTION: THREE PORTALS (ENTRANCE DOORS)
# Description: The three iconic Gothic pointed-arch doorways. Center portal
# (Portal of the Last Judgment) is largest; flanking portals slightly smaller.
# Pointed arches created with via control points for Gothic curves.
# -----------------------------------------------------------------------------

# --- Left Portal - Portal of the Virgin ---

# Outer arch
let portal_l_base_l : vec = (35, 195)
let portal_l_base_r : vec = (65, 195)
let portal_l_peak : vec = (50, 165)
draw stroke from portal_l_base_l to portal_l_peak via [(42, 172)]
draw stroke from portal_l_base_r to portal_l_peak via [(58, 172)]
trace stroke from portal_l_base_l to portal_l_base_r

# Inner archivolts (concentric arches)
let portal_l_arch2_l : vec = (38, 195)
let portal_l_arch2_r : vec = (62, 195)
let portal_l_arch2_peak : vec = (50, 169)
draw stroke from portal_l_arch2_l to portal_l_arch2_peak via [(43, 175)]
draw stroke from portal_l_arch2_r to portal_l_arch2_peak via [(57, 175)]

let portal_l_arch3_l : vec = (41, 195)
let portal_l_arch3_r : vec = (59, 195)
let portal_l_arch3_peak : vec = (50, 173)
