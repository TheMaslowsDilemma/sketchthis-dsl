# === POINT ZERO MARKER ===
# The bronze star from which all French road distances are measured
# Located in front of the cathedral entrance

let pz_center : vec = (100, 250)

# Outer octagonal boundary
let pz_octagon : sketch = [
    stroke from (96, 246) to (104, 246),
    stroke from (104, 246) to (108, 250),
    stroke from (108, 250) to (104, 254),
    stroke from (104, 254) to (96, 254),
    stroke from (96, 254) to (92, 250),
    stroke from (92, 250) to (96, 246)
]

# Inner star pattern
let pz_star : sketch = [
    stroke from (100, 246) to (100, 254),
    stroke from (92, 250) to (108, 250),
    stroke from (94, 247) to (106, 253),
    stroke from (106, 247) to (94, 253)
]

trace pz_octagon
draw pz_star

# Decorative dots at star points
