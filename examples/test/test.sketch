# Shading demo

# Shade a simple shape
let box = [
  stroke -> [(0,0), (40,0), (40,30), (0,30), (0,0)]
]
draw box
scribble shade box

# Shade a region, layer it for density
let hill = stroke ~> [(0,0), (20,15), (40,20), (60,15), (80,0)]
let ground = stroke -> [(0,0), (80,0)]
let mountain = [hill, ground]
draw mountain
scribble shade mountain
scribble shade mountain

# Shade reused across transforms
let leaf = stroke ~> [(0,0), (5,8), (3,15), (0,20), (-3,15), (-5,8)]
let shaded_leaf = [leaf, shade leaf]

draw [
  shaded_leaf |> at (50, 100),
  shaded_leaf |> scale 0.7 |> rotate 30 |> at (80, 110),
  shaded_leaf |> scale 0.8 |> rotate (-20) |> at (30, 95)
]

# Use regionof to store and reuse
let circle = stroke ~> [
  (10,0), (7,7), (0,10), (-7,7),
  (-10,0), (-7,-7), (0,-10), (7,-7)
]
let area = regionof circle
draw circle |> at (200, 150)
scribble shade area |> at (200, 150)