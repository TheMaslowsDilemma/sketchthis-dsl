# Front Right detailed veins
let frontRightMainVein : sketch = stroke from (110, 60) to (147, 20) via [(130, 42), (142, 28)]
let frontRightVein2 : sketch = stroke from (115, 58) to (150, 25) via [(135, 42)]
let frontRightVein3 : sketch = stroke from (122, 55) to (152, 30) via [(138, 44)]
