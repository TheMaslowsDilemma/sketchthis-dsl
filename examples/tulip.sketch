let frontRightTipA : sketch = stroke from (155, 25) to (148, 18) via [(154, 21)]
let frontRightTipB : sketch = stroke from (148, 18) to (138, 20) via [(143, 17)]
let frontRightInner : sketch = stroke from (138, 20) to (105, 58) via [(128, 28), (115, 42)]

