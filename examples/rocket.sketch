# === ROCKET BODY ===
let h : number = 120
let w : number = 24

# Nose cone (aerodynamic curve)
let nl : sketch = stroke (-w,0) to (0,-50) via [(-w,-20),(-12,-40)]
let nr : sketch = mirror nl about (0,1)
let nose : sketch = [nl, nr]

# Main body panels
let bl : sketch = stroke (-w,0) to (-w,h)
let br : sketch = stroke (w,0) to (w,h)
let body : sketch = [bl, br]

# Body details - rivets/panel lines
let pn1 : sketch = stroke (-w,30) to (w,30)
let pn2 : sketch = stroke (-w,60) to (w,60)
let pn3 : sketch = stroke (-w,90) to (w,90)
let pnls : sketch = [pn1, pn2, pn3]

# Circular window
let wt : sketch = stroke (-8,15) to (8,15) via [(0,5)]
let wb : sketch = stroke (8,15) to (-8,15) via [(0,25)]
let wnd : sketch = [wt, wb]

# Window shine
let sh : sketch = stroke (-4,12) to (-2,10)

# Second smaller window
let w2 : sketch = scale wnd by 0.6
let w2p : sketch = translate w2 by (0,30)

# USA text area (rectangle)
let txt : sketch = [stroke (-12,70) to (12,70), stroke (-12,78) to (12,78), stroke (-12,70) to (-12,78), stroke (12,70) to (12,78)]

# === FINS ===
let fout : sketch = stroke (w,85) to (45,h+25) via [(35,95)]
let fbot : sketch = stroke (45,h+25) to (w,h)
let fin : sketch = [fout, fbot]
let finL : sketch = mirror fin about (0,1)
let fins : sketch = [fin, finL]

# Fin struts
let fs : sketch = stroke (w,100) to (35,h+10)
let fsL : sketch = mirror fs about (0,1)

# === ENGINE BELL ===
let el : sketch = stroke (-18,h) to (-25,h+20) via [(-16,h+10)]
let er : sketch = mirror el about (0,1)
let eb : sketch = stroke (-25,h+20) to (25,h+20) via [(0,h+15)]
let eng : sketch = [el, er, eb]

# Engine nozzle inner
let ni : sketch = stroke (-12,h+5) to (12,h+5) via [(0,h+12)]

# === FLAMES ===
let fc : sketch = stroke (0,h+20) to (0,h+100) via [(15,h+45),(-20,h+60),(10,h+80)]
let fl : sketch = stroke (-15,h+20) to (-5,h+85) via [(-25,h+40),(-10,h+55),(-18,h+70)]
let fr : sketch = mirror fl about (0,1)
let fo : sketch = stroke (-22,h+22) to (0,h+70) via [(-30,h+35),(-15,h+50)]
let foR : sketch = mirror fo about (0,1)
let flm : sketch = [fc, fl, fr, fo, foR]

# Inner hot flame
let fi : sketch = stroke (0,h+20) to (0,h+60) via [(8,h+35),(-8,h+50)]
let fiL : sketch = translate fi by (-8,0)
let fiR : sketch = translate fi by (8,0)
let hot : sketch = [fi, fiL, fiR]

# === ASSEMBLE ROCKET ===
let rkt : sketch = [nose, body, pnls, wnd, sh, w2p, txt, fins, fs, fsL, eng, ni]
let R : sketch = translate rkt by (300,80)
let F : sketch = translate flm by (300,80)
let H : sketch = translate hot by (300,80)

# === LAUNCH PAD ===
let gnd : sketch = stroke (0,340) to (500,340)
let pdT : sketch = stroke (180,340) to (420,340) via [(300,320)]
let pdL : sketch = stroke (200,340) to (200,320)
let pdR : sketch = stroke (400,340) to (400,320)
let pad : sketch = [pdT, pdL, pdR]

# === LAUNCH TOWER ===
let tv : sketch = stroke (0,0) to (0,200)
let tw : sketch = [tv, translate tv by (30,0)]
let cr1 : sketch = stroke (0,0) to (30,30)
let cr2 : sketch = stroke (30,0) to (0,30)
let X : sketch = [cr1, cr2]
let x1 : sketch = translate X by (0,30)
let x2 : sketch = translate X by (0,90)
let x3 : sketch = translate X by (0,150)
let tX : sketch = [x1, x2, x3]
let arm : sketch = stroke (30,100) to (80,100)
let arm2 : sketch = stroke (30,130) to (60,130)
let twr : sketch = [tw, tX, arm, arm2]
let T : sketch = translate twr by (190,140)

# === SMOKE/EXHAUST CLOUDS ===
let cbase : sketch = stroke (0,0) to (60,0) via [(10,-20),(30,15),(50,-10)]
let c1 : sketch = translate cbase by (150,350)
let c2 : sketch = translate (scale cbase by 1.4) by (220,360)
let c3 : sketch = translate (mirror cbase about (1,0)) by (320,355)
let c4 : sketch = translate (scale cbase by 1.6) by (180,380)
let c5 : sketch = translate (mirror (scale cbase by 1.2) about (1,0)) by (280,375)
let c6 : sketch = translate (scale cbase by 0.8) by (130,370)
let c7 : sketch = translate (scale cbase by 2) by (200,400)
let smk : sketch = [c1,c2,c3,c4,c5,c6,c7]

# === MOON ===
let m1 : sketch = stroke (70,50) to (70,110) via [(110,50),(120,80),(110,110)]
let m2 : sketch = stroke (70,110) to (70,50) via [(30,110),(20,80),(30,50)]
let moon : sketch = [m1, m2]

# Craters (reusable)
let crat : sketch = stroke (0,0) to (12,0) via [(3,-6),(9,-6)]
let ct1 : sketch = translate crat by (55,70)
let ct2 : sketch = translate (scale crat by 0.6) by (75,90)
let ct3 : sketch = translate (scale crat by 0.5) by (60,95)
let ct4 : sketch = translate (scale crat by 0.8) by (80,65)
let crats : sketch = [ct1, ct2, ct3, ct4]

# Moon surface texture
let mtx : sketch = [dash (50,80), dash (85,75), dash (65,100)]

# === STARS ===
let star : sketch = [stroke (0,-4) to (0,4), stroke (-4,0) to (4,0)]
let st1 : sketch = translate star by (140,40)
let st2 : sketch = translate star by (420,60)
let st3 : sketch = translate star by (180,90)
let st4 : sketch = translate star by (460,30)
let st5 : sketch = translate star by (380,100)
let st6 : sketch = translate (scale star by 0.5) by (150,120)
let st7 : sketch = translate (scale star by 0.5) by (400,140)
let st8 : sketch = translate (scale star by 0.7) by (440,95)
let st9 : sketch = translate star by (200,30)
let st10 : sketch = translate (scale star by 0.6) by (480,120)
let stars : sketch = [st1,st2,st3,st4,st5,st6,st7,st8,st9,st10]

# Tiny dot stars
let ds : sketch = [dash (160,70), dash (350,45), dash (470,80), dash (130,100), dash (390,130), dash (250,50), dash (480,55)]

# === TRAJECTORY ===
let trj : sketch = stroke (300,80) to (90,70) via [(250,30),(180,25),(130,40)]

# === EARTH CURVE (horizon) ===
let erth : sketch = stroke (0,380) to (500,380) via [(250,350)]

# === KENNEDY SIGN ===
let sign : sketch = [stroke (30,330) to (30,340), stroke (30,330) to (80,330), stroke (80,330) to (80,340)]

# === RENDER SCENE ===
# Sky objects
draw moon
draw crats
trace mtx
trace stars
trace ds
draw trj

# Ground structures
trace gnd
draw pad
draw T
draw sign
draw erth

# Rocket
draw R
scribble F
scribble H

# Smoke
scribble smk