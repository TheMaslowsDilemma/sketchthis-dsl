# ==========================================
#  Regatta — Sunday Race
#  Canvas: 420 x 297mm (A3 landscape)
# ==========================================


# ------------------------------------------
#  Sky
# ------------------------------------------

# Sun
let sun_disc = stroke ~> [
  (380, 270), (375, 278), (374, 286), (376, 292),
  (382, 295), (388, 292), (390, 286), (389, 278), (380, 270)
]

let ray = stroke -> [(0, 0), (0, 8)]

trace sun_disc

draw [
  ray |> at (380, 298),
  ray |> rotate 45 |> at (392, 294),
  ray |> rotate 90 |> at (394, 284),
  ray |> rotate 135 |> at (392, 274),
  ray |> rotate 180 |> at (380, 267),
  ray |> rotate 225 |> at (368, 274),
  ray |> rotate 270 |> at (366, 284),
  ray |> rotate 315 |> at (368, 294)
]

# Clouds
let cloud_puff = stroke ~> [(0, 0), (-5, 3), (0, 6), (5, 3), (0, 0)]

let cloud = [
  cloud_puff,
  cloud_puff |> translate (8, 0),
  cloud_puff |> scale 0.7 |> translate (4, 4)
]

scribble [
  cloud |> at (40, 275),
  cloud |> scale 0.6 |> at (150, 268),
  cloud |> scale 0.8 |> at (100, 260),
  cloud |> scale 0.5 |> at (250, 272),
  cloud |> scale 0.7 |> at (310, 265)
]


# ------------------------------------------
#  Distant shore
# ------------------------------------------

draw stroke ~> [
  (0, 230), (50, 232), (100, 234), (150, 233),
  (200, 235), (250, 234), (300, 232), (350, 233), (420, 231)
]

# Lighthouse
let lighthouse_body = stroke -> [(355, 233), (353, 255), (357, 255), (355, 233)]
let lighthouse_top = stroke -> [(351, 255), (359, 255), (359, 258), (351, 258)]
let lighthouse_lamp = stroke ~> [
  (352, 258), (355, 262), (358, 258)
]
let lighthouse_stripe_1 = stroke -> [(353.5, 240), (356.5, 240)]
let lighthouse_stripe_2 = stroke -> [(353.2, 245), (356.8, 245)]
let lighthouse_stripe_3 = stroke -> [(353, 250), (357, 250)]

trace [lighthouse_body, lighthouse_top, lighthouse_lamp]
draw [lighthouse_stripe_1, lighthouse_stripe_2, lighthouse_stripe_3]

# Light beam
scribble [
  stroke ~> [(358, 260), (375, 264), (395, 266)],
  stroke ~> [(352, 260), (335, 264), (315, 266)]
]

# Shore trees — silhouettes
let shore_tree = stroke ~> [
  (0, 0), (-2, 5), (-3, 10), (0, 14), (3, 10), (2, 5), (0, 0)
]

draw [
  shore_tree |> scale 0.5 |> at (30, 233),
  shore_tree |> scale 0.4 |> at (40, 234),
  shore_tree |> scale 0.45 |> at (50, 233),
  shore_tree |> scale 0.3 |> at (110, 234),
  shore_tree |> scale 0.35 |> at (120, 235),
  shore_tree |> scale 0.4 |> at (260, 234),
  shore_tree |> scale 0.3 |> at (270, 233),
  shore_tree |> scale 0.35 |> at (280, 234)
]


# ------------------------------------------
#  Boat components
# ------------------------------------------

# Hull — smooth curve with keel
let hull = stroke ~> [(-12, 0), (-10, 4), (0, 6), (10, 4), (12, 0)]
let keel_line = stroke ~> [(-10, 1), (0, 2), (10, 1)]

# Mast
let mast = stroke -> [(0, 6), (0, 32)]

# Mainsail — triangular with batten curves
let mainsail = [
  stroke ~> [(1, 8), (2, 18), (1, 30)],
  stroke ~> [(1, 30), (8, 22), (14, 10)],
  stroke -> [(14, 10), (1, 8)]
]

# Jib — headsail
let jib = [
  stroke ~> [(-1, 8), (-0.5, 16), (0, 26)],
  stroke ~> [(0, 26), (-5, 18), (-10, 8)],
  stroke -> [(-10, 8), (-1, 8)]
]

# Spinnaker — for lead boats, billowing
let spinnaker = stroke ~> [
  (0, 26), (-5, 28), (-12, 24), (-14, 18),
  (-12, 12), (-8, 8), (-1, 8)
]

# Flag — pennant at masthead
let flag = [
  stroke -> [(0, 32), (6, 30)],
  stroke -> [(6, 30), (0, 28)]
]

# Wake — trailing foam
let wake = stroke ~> [(12, 0), (18, -1), (25, 0), (30, -1)]

# Full boat assembly
let boat = [hull, keel_line, mast, mainsail, jib, flag]

# Boat with spinnaker
let racing_boat = [hull, keel_line, mast, mainsail, spinnaker, flag]


# ------------------------------------------
#  Lead group — closest, largest
# ------------------------------------------

# Leader with spinnaker and shaded sails
let leader = [
  racing_boat,
  shade mainsail,
  shade spinnaker
]

trace leader |> rotate 8 |> at (150, 160)
draw wake |> rotate 8 |> at (162, 154)

# Second place
draw boat |> scale 0.65 |> rotate (-5) |> at (190, 165)
scribble shade mainsail |> scale 0.65 |> rotate (-5) |> at (190, 165)
draw wake |> scale 0.6 |> rotate (-5) |> at (198, 160)

# Third
draw boat |> scale 0.4 |> rotate 12 |> at (175, 172)
draw wake |> scale 0.35 |> rotate 12 |> at (182, 168)


# ------------------------------------------
#  Chase group — middle distance
# ------------------------------------------

draw [
  boat |> scale 0.65 |> rotate (-8) |> at (230, 180),
  boat |> scale 0.8 |> rotate 5 |> at (260, 175),
  boat |> scale 0.4 |> rotate (-12) |> at (245, 188)
]

scribble [
  shade mainsail |> scale 0.65 |> rotate (-8) |> at (230, 180),
  shade mainsail |> scale 0.8 |> rotate 5 |> at (260, 175)
]

# Wakes
draw [
  wake |> scale 0.5 |> rotate (-8) |> at (238, 176),
  wake |> scale 0.6 |> rotate 5 |> at (272, 169),
  wake |> scale 0.3 |> rotate (-12) |> at (250, 184)
]


# ------------------------------------------
#  Distant boats — tiny near horizon
# ------------------------------------------

draw [
  boat |> scale 0.25 |> rotate 6 |> at (100, 218),
  boat |> scale 0.2 |> rotate (-4) |> at (140, 222),
  boat |> scale 0.3 |> rotate (-8) |> at (180, 215),
  boat |> scale 0.2 |> rotate 3 |> at (300, 220),
  boat |> scale 0.15 |> rotate (-5) |> at (330, 224),
  boat |> scale 0.25 |> rotate 7 |> at (210, 222)
]


# ------------------------------------------
#  Buoys — course markers
# ------------------------------------------

let buoy_body = stroke ~> [
  (0, 0), (-2, 3), (-2, 7), (0, 10), (2, 7), (2, 3), (0, 0)
]
let buoy_flag = [
  stroke -> [(0, 10), (0, 15)],
  stroke -> [(0, 15), (4, 13)],
  stroke -> [(4, 13), (0, 12)]
]
let buoy = [buoy_body, buoy_flag]

trace [
  buoy |> at (120, 180),
  buoy |> scale 0.6 |> at (310, 200)
]


# ------------------------------------------
#  Sea — layered waves
# ------------------------------------------

let wave = stroke ~> [(0, 0), (5, 2), (10, -1), (15, 1.5), (20, 0)]

let wave_row = [
  wave,
  wave |> translate (25, 0),
  wave |> translate (50, 0),
  wave |> translate (75, 0),
  wave |> translate (100, 0),
  wave |> translate (125, 0),
  wave |> translate (150, 0),
  wave |> translate (175, 0),
  wave |> translate (200, 0),
  wave |> translate (225, 0),
  wave |> translate (250, 0),
  wave |> translate (275, 0),
  wave |> translate (300, 0),
  wave |> translate (325, 0),
  wave |> translate (350, 0),
  wave |> translate (375, 0)
]

# Foreground waves — large
draw wave_row |> scale 1.2 |> at (210, 60)
draw wave_row |> at (210, 75)
draw wave_row |> at (210, 90)

# Mid waves
scribble [
  wave_row |> scale 0.85 |> at (210, 105),
  wave_row |> scale 0.85 |> at (215, 120),
  wave_row |> scale 0.7 |> at (210, 135),
  wave_row |> scale 0.7 |> at (215, 150)
]

# Far waves — barely visible
scribble [
  wave_row |> scale 0.5 |> at (210, 170),
  wave_row |> scale 0.4 |> at (215, 185),
  wave_row |> scale 0.3 |> at (210, 200),
  wave_row |> scale 0.25 |> at (215, 210),
  wave_row |> scale 0.2 |> at (210, 220)
]

# Foam on crests — foreground
scribble dash [
  (20, 63), (40, 65), (70, 62), (100, 64), (130, 61),
  (160, 63), (200, 65), (240, 62), (280, 64), (320, 63),
  (360, 61), (400, 64),
  (30, 78), (60, 76), (90, 79), (120, 77), (150, 78),
  (190, 76), (220, 79), (260, 77), (300, 78), (340, 76),
  (380, 79)
]


# ------------------------------------------
#  Birds — gulls
# ------------------------------------------

let wing_r = stroke ~> [(0, 0), (3, 3), (7, 4)]
let wing_l = stroke ~> [(0, 0), (-3, 3), (-7, 4)]
let gull = [wing_r, wing_l]

draw [
  gull |> at (80, 255),
  gull |> scale 0.8 |> at (90, 260),
  gull |> scale 0.6 |> at (85, 250),
  gull |> scale 0.7 |> at (95, 253)
]

draw [
  gull |> scale 0.5 |> at (200, 245),
  gull |> scale 0.4 |> at (210, 248),
  gull |> scale 0.45 |> at (195, 242)
]

# Low gull skimming water
draw gull |> scale 0.9 |> at (60, 90)
scribble dash [(65, 87), (70, 86), (75, 87)]


# ------------------------------------------
#  Reflections — broken verticals in water
# ------------------------------------------

# Lead boat mast reflection
scribble [
  stroke -> [(150, 148), (150, 140)],
  stroke -> [(150, 136), (150, 130)],
  stroke -> [(150, 126), (150, 120)]
]

# Chase group reflections
scribble [
  stroke -> [(260, 163), (260, 158)],
  stroke -> [(260, 155), (260, 150)],
  stroke -> [(230, 168), (230, 163)],
  stroke -> [(230, 160), (230, 155)]
]


# ------------------------------------------
#  Foreground detail — rope and cleat
# ------------------------------------------

let rope = stroke ~> [
  (10, 30), (15, 35), (20, 32), (30, 38), (40, 34), (50, 40)
]

let cleat = [
  stroke -> [(5, 28), (5, 35), (15, 35), (15, 28)],
  stroke -> [(3, 35), (17, 35)]
]

draw [rope, cleat]

# Spray droplets in foreground
scribble dot [
  (25, 45), (32, 48), (18, 42), (40, 46),
  (55, 44), (65, 47), (72, 43)
]
