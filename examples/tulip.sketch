# Ground texture dashes
scribble dash at (75, 184)
scribble dash at (85, 184)
scribble dash at (95, 184)
scribble dash at (105, 184)
scribble dash at (115, 184)
scribble dash at (125, 184)

# ═══════════════════════════════════════════════════════════════
# FINAL FLOURISHES - Additional botanical details
# ═══════════════════════════════════════════════════════════════

# Tiny leaf emerging at stem base
let tinyLeafLeft : sketch = stroke from (96, 165) to (82, 158) via [(88, 162)]
let tinyLeafRight : sketch = stroke from (82, 158) to (95, 162) via [(86, 158)]
let tinyLeafVein : sketch = stroke from (94, 163) to (84, 159)

