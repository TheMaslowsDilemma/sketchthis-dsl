# Small leaf on right side of stem
let smallLeafOuter : sketch = stroke from (104, 158) to (125, 152) via [(115, 154)]
let smallLeafTip : sketch = stroke from (125, 152) to (128, 150)
let smallLeafReturn : sketch = stroke from (128, 150) to (105, 155) via [(118, 150), (110, 152)]
let smallLeafVein : sketch = stroke from (106, 156) to (126, 151) via [(116, 153)]

