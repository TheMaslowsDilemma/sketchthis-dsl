# ═══════════════════════════════════════════════════════════════
# PETAL OVERLAP DETAILS - Creating depth
# ═══════════════════════════════════════════════════════════════

# Shadow lines where petals meet
let overlapLeft : sketch = stroke from (88, 58) to (82, 48) via [(85, 53)]
let overlapRight : sketch = stroke from (112, 58) to (118, 48) via [(115, 53)]
let overlapCenterLeft : sketch = stroke from (92, 56) to (88, 50)
let overlapCenterRight : sketch = stroke from (108, 56) to (112, 50)

draw [overlapLeft, overlapRight, overlapCenterLeft, overlapCenterRight]

# ═══════════════════════════════════════════════════════════════
# CALYX AND SEPAL HINTS - Where flower meets stem
# ═══════════════════════════════════════════════════════════════

let sepalLeft : sketch = stroke from (92, 65) to (88, 72) via [(90, 68)]
let sepalRight : sketch = stroke from (108, 65) to (112, 72) via [(110, 68)]
let sepalCenter : sketch = stroke from (100, 62) to (100, 68)

let sepalDetailLeft : sketch = stroke from (88, 72) to (96, 68) via [(92, 70)]
let sepalDetailRight : sketch = stroke from (112, 72) to (104, 68) via [(108, 70)]

draw [sepalLeft, sepalRight, sepalCenter, sepalDetailLeft, sepalDetailRight]

# ═══════════════════════════════════════════════════════════════
# ATMOSPHERIC DETAILS - Ground shadow suggestion
# ═══════════════════════════════════════════════════════════════

# Subtle ground shadow
let shadowLeft : sketch = stroke from (85, 182) to (70, 185) via [(78, 184)]
let shadowRight : sketch = stroke from (115, 182) to (130, 185) via [(122, 184)]
let shadowCenter : sketch = stroke from (90, 183) to (110, 183)

