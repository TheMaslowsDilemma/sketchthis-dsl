-- Notre Dame Cathedral - Aerial Perspective View
-- Detailed architectural rendering showing the cruciform plan,
-- twin western towers, central spire, flying buttresses, and roof structure

-- ============================================
-- MAIN NAVE (Central body running East-West)
-- ============================================

-- Nave outline - the long rectangular body
-- nave starts at (60, 110), length=280, width=80

let nave_north : sketch = line from (60, 110) to (340, 110)
let nave_south : sketch = line from (60, 190) to (340, 190)
let nave_east : sketch = line from (340, 110) to (340, 190)

-- Nave roof ridge line (center peak at y=150)
let nave_ridge : sketch = line from (100, 150) to (330, 150)

-- Nave roof slope lines (showing pitched roof from above)
let roof_line_n1 : sketch = line from (110, 118) to (110, 150)
let roof_line_n2 : sketch = line from (160, 118) to (160, 150)
let roof_line_n3 : sketch = line from (210, 118) to (210, 150)
let roof_line_n4 : sketch = line from (260, 118) to (260, 150)
let roof_line_n5 : sketch = line from (310, 118) to (310, 150)

let roof_line_s1 : sketch = line from (110, 182) to (110, 150)
let roof_line_s2 : sketch = line from (160, 182) to (160, 150)
let roof_line_s3 : sketch = line from (210, 182) to (210, 150)
let roof_line_s4 : sketch = line from (260, 182) to (260, 150)
let roof_line_s5 : sketch = line from (310, 182) to (310, 150)

-- ============================================
-- WESTERN FACADE WITH TWIN TOWERS
-- ============================================

-- North Tower at (60, 92) - 40 wide, 35 deep
let north_tower_w : sketch = line from (60, 92) to (60, 132)
let north_tower_n : sketch = line from (60, 92) to (100, 92)
let north_tower_s : sketch = line from (60, 132) to (100, 132)
let north_tower_e : sketch = line from (100, 92) to (100, 132)

-- North tower roof detail (inner rectangle)
let nt_inner1 : sketch = line from (65, 97) to (95, 97)
let nt_inner2 : sketch = line from (65, 127) to (95, 127)
let nt_inner3 : sketch = line from (65, 97) to (65, 127)
let nt_inner4 : sketch = line from (95, 97) to (95, 127)

-- North tower corner pinnacles
let nt_pin1 : sketch = dot (63, 95)
let nt_pin2 : sketch = dot (97, 95)
let nt_pin3 : sketch = dot (63, 129)
let nt_pin4 : sketch = dot (97, 129)

-- South Tower at (60, 168) - 40 wide, 35 deep
let south_tower_w : sketch = line from (60, 168) to (60, 208)
let south_tower_n : sketch = line from (60, 168) to (100, 168)
let south_tower_s : sketch = line from (60, 208) to (100, 208)
let south_tower_e : sketch = line from (100, 168) to (100, 208)

-- South tower roof detail
let st_inner1 : sketch = line from (65, 173) to (95, 173)
let st_inner2 : sketch = line from (65, 203) to (95, 203)
let st_inner3 : sketch = line from (65, 173) to (65, 203)
let st_inner4 : sketch = line from (95, 173) to (95, 203)

-- South tower corner pinnacles
let st_pin1 : sketch = dot (63, 171)
let st_pin2 : sketch = dot (97, 171)
let st_pin3 : sketch = dot (63, 205)
let st_pin4 : sketch = dot (97, 205)

-- Western facade between towers
let facade_top : sketch = line from (100, 132) to (100, 168)

-- ============================================
-- TRANSEPT (North-South crossing)
-- ============================================

-- Transept at x=240, width=45, extends 50 beyond nave

-- North Transept
let trans_n_w : sketch = line from (240, 110) to (240, 60)
let trans_n_e : sketch = line from (285, 110) to (285, 60)
let trans_n_n : sketch = line from (240, 60) to (285, 60)

-- North transept roof ridge
let trans_n_ridge : sketch = line from (262, 105) to (262, 65)

-- North transept rose window
let trans_n_rose : sketch = arc center (262, 75) (8, 8) from 0 to 360
let trans_n_rose_inner : sketch = arc center (262, 75) (4, 4) from 0 to 360

-- South Transept
let trans_s_w : sketch = line from (240, 190) to (240, 240)
let trans_s_e : sketch = line from (285, 190) to (285, 240)
let trans_s_s : sketch = line from (240, 240) to (285, 240)

-- South transept roof ridge
let trans_s_ridge : sketch = line from (262, 195) to (262, 235)

-- South transept rose window
let trans_s_rose : sketch = arc center (262, 225) (8, 8) from 0 to 360
let trans_s_rose_inner : sketch = arc center (262, 225) (4, 4) from 0 to 360

-- ============================================
-- CENTRAL SPIRE (at crossing)
-- ============================================

-- Spire center at (262, 150), radius 12

-- Spire base (octagonal from above)
let spire_base1 : sketch = line from (250, 144) to (256, 138)
let spire_base2 : sketch = line from (256, 138) to (268, 138)
let spire_base3 : sketch = line from (268, 138) to (274, 144)
