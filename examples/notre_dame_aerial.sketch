let spire_base7 : sketch = line from (256, 162) to (250, 156)
let spire_base8 : sketch = line from (250, 156) to (250, 144)

-- Spire tip (converging lines to center point)
let spire_tip : sketch = dot (262, 150)
let spire_line1 : sketch = line from (262, 150) to (250, 144)
let spire_line2 : sketch = line from (262, 150) to (262, 138)
let spire_line3 : sketch = line from (262, 150) to (274, 144)
let spire_line4 : sketch = line from (262, 150) to (274, 156)
let spire_line5 : sketch = line from (262, 150) to (262, 162)
let spire_line6 : sketch = line from (262, 150) to (250, 156)

-- Decorative statues around spire base (the apostles)
let apostle1 : sketch = dot (245, 150)
let apostle2 : sketch = dot (279, 150)
let apostle3 : sketch = dot (262, 133)
let apostle4 : sketch = dot (262, 167)

