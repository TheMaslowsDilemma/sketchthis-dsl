# ═══════════════════════════════════════════════════════════════
# EXTREMELY DETAILED MALE FACE STUDY
# Close-up portrait demonstrating all facial features
# Canvas: 200mm x 250mm (portrait orientation)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# PART 1: SKULL STRUCTURE & FACE OUTLINE
# The foundation - bone structure defines everything
# ═══════════════════════════════════════════════════════════════

# Cranium - top of head
let skull_top : sketch = stroke from (60, 35) to (140, 35) via [(100, 12)]

# Temples - where skull narrows
let temple_left : sketch = stroke from (60, 35) to (52, 65) via [(54, 50)]
let temple_right : sketch = stroke from (140, 35) to (148, 65) via [(146, 50)]

# Cheekbones - prominent facial structure
let cheekbone_left : sketch = stroke from (52, 65) to (48, 95) via [(45, 80)]
let cheekbone_right : sketch = stroke from (148, 65) to (152, 95) via [(155, 80)]

# Cheek hollow (below cheekbone)
let cheek_left : sketch = stroke from (48, 95) to (55, 130) via [(50, 112)]
let cheek_right : sketch = stroke from (152, 95) to (145, 130) via [(150, 112)]

# Jaw line - strong angular
let jaw_left : sketch = stroke from (55, 130) to (75, 165) via [(60, 148)]
let jaw_right : sketch = stroke from (145, 130) to (125, 165) via [(140, 148)]

# Chin
let chin : sketch = stroke from (75, 165) to (125, 165) via [(100, 178)]
let chin_cleft : sketch = stroke from (100, 172) to (100, 176)

# Jawline shading - defines masculine structure
let jaw_shading : sketch = [
  dash at (58, 135), dash at (60, 142), dash at (63, 149), dash at (68, 156),
  dash at (142, 135), dash at (140, 142), dash at (137, 149), dash at (132, 156),
  dash at (80, 168), dash at (90, 172), dash at (100, 174), dash at (110, 172), dash at (120, 168)
]

# Cheekbone highlight/shadow
let cheekbone_shading : sketch = [
  dash at (46, 82), dash at (47, 88), dash at (49, 94),
  dash at (154, 82), dash at (153, 88), dash at (151, 94),
  # Hollow beneath
  dash at (52, 100), dash at (53, 108), dash at (54, 116),
  dash at (148, 100), dash at (147, 108), dash at (146, 116)
]

let face_structure : sketch = [
  skull_top, temple_left, temple_right,
  cheekbone_left, cheekbone_right,
  cheek_left, cheek_right,
  jaw_left, jaw_right,
  chin, chin_cleft
]

trace face_structure
scribble jaw_shading
scribble cheekbone_shading

