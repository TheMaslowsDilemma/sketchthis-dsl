# Front Center elegant veins
let frontCenterVein1 : sketch = stroke from (95, 60) to (88, 15) via [(92, 40), (89, 25)]
let frontCenterVein2 : sketch = stroke from (100, 60) to (100, 12) via [(100, 35)]
let frontCenterVein3 : sketch = stroke from (105, 60) to (112, 15) via [(108, 40), (111, 25)]
