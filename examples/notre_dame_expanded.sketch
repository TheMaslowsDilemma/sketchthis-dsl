# -----------------------------------------------------------------------------
# SECTION: GROUND PLANE & PARVIS
# Description: The plaza (parvis) in front of the cathedral, shown with 
# perspective lines converging toward the entrance. Cobblestone texture
# suggested through dashes following the flow field. Includes the famous
# Point Zero marker from which all French road distances are measured.
# -----------------------------------------------------------------------------

# Vanishing point reference (cathedral entrance center)
let vp : vec = (100, 195)

# === PERSPECTIVE CONVERGENCE LINES ===
# Radiating lines from vanishing point to bottom edge create depth

# Primary convergence lines (traced for structure)
let converge_left_far : sketch = stroke from vp to (0, 280)
let converge_left_mid : sketch = stroke from vp to (30, 280)
let converge_left_near : sketch = stroke from vp to (60, 280)
let converge_center : sketch = stroke from vp to (100, 280)
let converge_right_near : sketch = stroke from vp to (140, 280)
let converge_right_mid : sketch = stroke from vp to (170, 280)
let converge_right_far : sketch = stroke from vp to (200, 280)

trace [
    converge_left_far,
    converge_left_mid,
    converge_left_near,
    converge_center,
    converge_right_near,
    converge_right_mid,
    converge_right_far
]

# Secondary convergence lines (drawn for softer appearance)
let converge_sec_1 : sketch = stroke from vp to (15, 280)
let converge_sec_2 : sketch = stroke from vp to (45, 280)
let converge_sec_3 : sketch = stroke from vp to (75, 280)
let converge_sec_4 : sketch = stroke from vp to (125, 280)
let converge_sec_5 : sketch = stroke from vp to (155, 280)
let converge_sec_6 : sketch = stroke from vp to (185, 280)

draw [
    converge_sec_1,
    converge_sec_2,
    converge_sec_3,
    converge_sec_4,
    converge_sec_5,
    converge_sec_6
]

# === HORIZONTAL GROUND LINES ===
# Foreshortened spacing - closer together near vanishing point

# Near vanishing point (tight spacing)
trace stroke from (45, 200) to (155, 200)
trace stroke from (42, 205) to (158, 205)
trace stroke from (38, 210) to (162, 210)
trace stroke from (34, 216) to (166, 216)
trace stroke from (28, 223) to (172, 223)

# Middle ground (medium spacing)
trace stroke from (22, 231) to (178, 231)
trace stroke from (15, 240) to (185, 240)
trace stroke from (8, 250) to (192, 250)

# Foreground (wider spacing)
trace stroke from (0, 262) to (200, 262)
trace stroke from (0, 275) to (200, 275)

# === EDGE BOUNDARIES ===
# Vertical edges of the parvis area
let ground_left : sketch = stroke from (0, 280) to (0, 200)
let ground_right : sketch = stroke from (200, 280) to (200, 200)
trace [ground_left, ground_right]

# === COBBLESTONE TEXTURE - NEAR VANISHING POINT ===
# Denser, smaller pattern near cathedral base

let cobble_row_1 : sketch = [
    dash at (70, 198),
    dash at (85, 199),
    dash at (100, 197),
    dash at (115, 199),
    dash at (130, 198)
]

