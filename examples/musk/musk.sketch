# ==========================================
#  Portrait — Elon Musk
#  Canvas: 420 x 297mm (A3 landscape)
#  Centered bust portrait
# ==========================================


# ------------------------------------------
#  Face outline
# ------------------------------------------

# Jawline and chin — angular, square jaw
let face_right = stroke ~> [
  (240, 220), (242, 200), (240, 180), (235, 165),
  (228, 155), (218, 148), (210, 145)
]

let face_left = stroke ~> [
  (180, 220), (178, 200), (180, 180), (185, 165),
  (192, 155), (202, 148), (210, 145)
]

trace [face_right, face_left]

# Chin definition
draw stroke ~> [(202, 148), (210, 145), (218, 148)]


# ------------------------------------------
#  Forehead and hairline
# ------------------------------------------

# Receding hairline — M shape
let hairline = stroke ~> [
  (180, 220), (183, 228), (190, 235), (195, 232),
  (200, 228), (205, 232), (210, 236),
  (215, 232), (220, 228), (225, 232),
  (230, 235), (237, 228), (240, 220)
]

trace hairline


# ------------------------------------------
#  Hair — short, textured
# ------------------------------------------

# Top hair volume
let hair_top = stroke ~> [
  (185, 232), (195, 245), (205, 248),
  (215, 248), (225, 245), (235, 232)
]

draw hair_top

# Hair texture strokes
let hair_strand = stroke ~> [(0, 0), (1, 6), (0, 10)]

scribble [
  hair_strand |> at (192, 234),
  hair_strand |> rotate 5 |> at (198, 237),
  hair_strand |> rotate (-3) |> at (204, 239),
  hair_strand |> at (210, 240),
  hair_strand |> rotate 3 |> at (216, 239),
  hair_strand |> rotate (-5) |> at (222, 237),
  hair_strand |> at (228, 234),
  hair_strand |> scale 0.7 |> at (195, 230),
  hair_strand |> scale 0.7 |> rotate (-4) |> at (225, 230)
]

# Hair shading — denser at sides
scribble dash [
  (187, 233), (189, 236), (191, 238),
  (229, 233), (231, 236), (233, 238),
  (193, 240), (197, 243), (201, 245),
  (219, 245), (223, 243), (227, 240)
]


# ------------------------------------------
#  Eyebrows — thick, straight, slightly angled
# ------------------------------------------

let brow_r = stroke ~> [(215, 203), (220, 205), (228, 205), (233, 203)]
let brow_l = stroke ~> [(205, 203), (200, 205), (192, 205), (187, 203)]

draw [brow_r, brow_l]

# Brow thickness
draw [
  stroke ~> [(216, 204), (221, 206), (228, 206), (232, 204)],
  stroke ~> [(204, 204), (199, 206), (192, 206), (188, 204)]
]


# ------------------------------------------
#  Eyes
# ------------------------------------------

# Right eye
let eye_r_top = stroke ~> [(217, 197), (221, 200), (226, 200), (230, 197)]
let eye_r_bot = stroke ~> [(217, 197), (221, 195), (226, 195), (230, 197)]
let iris_r = stroke ~> [
  (222, 199), (221, 198), (222, 196), (224, 196),
  (225, 198), (224, 199), (222, 199)
]
let pupil_r = dot (223, 197.5)

# Left eye
let eye_l_top = stroke ~> [(203, 197), (199, 200), (194, 200), (190, 197)]
let eye_l_bot = stroke ~> [(203, 197), (199, 195), (194, 195), (190, 197)]
let iris_l = stroke ~> [
  (198, 199), (197, 198), (198, 196), (200, 196),
  (201, 198), (200, 199), (198, 199)
]
let pupil_l = dot (199, 197.5)

trace [eye_r_top, eye_r_bot, eye_l_top, eye_l_bot]
draw [iris_r, iris_l]
trace [pupil_r, pupil_l]

# Eyelid creases
draw [
  stroke ~> [(218, 201), (223, 203), (229, 201)],
  stroke ~> [(202, 201), (197, 203), (191, 201)]
]

# Under-eye lines
scribble [
  stroke ~> [(219, 194), (223, 193), (228, 194)],
  stroke ~> [(201, 194), (197, 193), (192, 194)]
]


# ------------------------------------------
#  Nose
# ------------------------------------------

# Bridge — subtle
draw stroke ~> [(210, 200), (211, 192), (212, 184)]

# Nose tip and nostrils
let nose_tip = stroke ~> [(207, 174), (210, 172), (213, 174)]
let nostril_r = stroke ~> [(213, 174), (215, 175), (214, 177)]
let nostril_l = stroke ~> [(207, 174), (205, 175), (206, 177)]

draw [nose_tip, nostril_r, nostril_l]

# Nose shadow — right side
scribble dash [(213, 178), (214, 180), (214, 183)]


# ------------------------------------------
#  Mouth
# ------------------------------------------

# Upper lip — slight smirk, right side higher
let upper_lip = stroke ~> [
  (200, 164), (204, 166), (208, 167), (210, 166),
  (212, 167), (216, 166), (221, 163)
]

# Lower lip — fuller
let lower_lip = stroke ~> [
  (200, 164), (205, 161), (210, 160), (215, 161), (221, 163)
]

# Lip line
let lip_line = stroke ~> [
  (201, 164), (206, 165), (210, 165.5), (214, 165), (220, 163.5)
]

trace lip_line
draw [upper_lip, lower_lip]

# Lower lip shadow
scribble stroke ~> [(204, 159), (210, 158), (216, 159)]

# Nasolabial folds
draw [
  stroke ~> [(205, 177), (202, 170), (200, 165)],
  stroke ~> [(215, 177), (218, 170), (220, 165)]
]


# ------------------------------------------
#  Chin detail
# ------------------------------------------

# Chin dimple
draw stroke ~> [(209, 151), (210, 149), (211, 151)]

# Chin shadow
scribble dash [(205, 150), (210, 148), (215, 150)]


# ------------------------------------------
#  Ears
# ------------------------------------------

# Right ear
let ear_r = stroke ~> [
  (240, 205), (244, 202), (246, 196), (245, 190),
  (242, 186), (240, 188)
]
let ear_r_inner = stroke ~> [
  (241, 202), (243, 198), (243, 192), (241, 189)
]

# Left ear
let ear_l = stroke ~> [
  (180, 205), (176, 202), (174, 196), (175, 190),
  (178, 186), (180, 188)
]
let ear_l_inner = stroke ~> [
  (179, 202), (177, 198), (177, 192), (179, 189)
]

draw [ear_r, ear_r_inner, ear_l, ear_l_inner]


# ------------------------------------------
#  Neck and shoulders
# ------------------------------------------

# Neck
draw [
  stroke ~> [(200, 148), (198, 135), (196, 120)],
  stroke ~> [(220, 148), (222, 135), (224, 120)]
]

# Adam's apple hint
draw stroke ~> [(209, 138), (210, 135), (211, 138)]

# Shoulders
let shoulder_r = stroke ~> [
  (224, 120), (240, 118), (260, 114), (280, 108),
  (300, 100), (310, 95)
]

let shoulder_l = stroke ~> [
  (196, 120), (180, 118), (160, 114), (140, 108),
  (120, 100), (110, 95)
]

draw [shoulder_r, shoulder_l]


# ------------------------------------------
#  Collar — crew neck / t-shirt
# ------------------------------------------

let collar = stroke ~> [
  (196, 120), (200, 117), (205, 115), (210, 114),
  (215, 115), (220, 117), (224, 120)
]

trace collar

# Collar shadow
scribble [
  stroke ~> [(198, 118), (205, 113), (210, 112), (215, 113), (222, 118)],
  dash [(202, 114), (208, 112), (212, 112), (218, 114)]
]


# ------------------------------------------
#  Shirt shading
# ------------------------------------------

scribble [
  stroke ~> [(200, 115), (195, 108), (185, 102)],
  stroke ~> [(220, 115), (225, 108), (235, 102)],
  stroke ~> [(190, 110), (180, 104), (170, 100)],
  stroke ~> [(230, 110), (240, 104), (250, 100)]
]

scribble dash [
  (195, 112), (190, 108), (185, 105), (180, 102),
  (225, 112), (230, 108), (235, 105), (240, 102),
  (170, 102), (165, 100), (160, 98),
  (250, 102), (255, 100), (260, 98)
]


# ------------------------------------------
#  Face shading — contour and depth
# ------------------------------------------

# Cheek shadow — right
scribble dash [
  (232, 185), (233, 180), (234, 175),
  (233, 170), (231, 165), (228, 160)
]

# Cheek shadow — left (lighter)
scribble dash [
  (188, 183), (187, 178), (186, 173)
]

# Temple shadows
scribble dash [
  (237, 212), (238, 208), (238, 204),
  (183, 212), (182, 208), (182, 204)
]

# Under chin shadow
scribble dash [
  (200, 146), (205, 144), (210, 143),
  (215, 144), (220, 146)
]

# Forehead shading — subtle
scribble dash [
  (195, 222), (200, 224), (205, 225),
  (215, 225), (220, 224), (225, 222)
]

# Jaw definition — right side stronger
draw stroke ~> [(235, 165), (230, 158), (225, 153)]
scribble dash [(232, 162), (230, 158), (227, 155)]
