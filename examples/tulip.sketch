# Back Center Petal (peeks out at top)
let backCenterLeft : sketch = stroke from (92, 52) to (88, 5) via [(88, 35), (85, 18)]
let backCenterTip : sketch = stroke from (88, 5) to (100, 0) via [(92, 2), (96, 0)]
let backCenterTip2 : sketch = stroke from (100, 0) to (112, 5) via [(104, 0), (108, 2)]
let backCenterRight : sketch = stroke from (112, 5) to (108, 52) via [(115, 18), (112, 35)]

draw [backCenterLeft, backCenterTip, backCenterTip2, backCenterRight]

# Back center veins
let backCenterVein1 : sketch = stroke from (98, 50) to (95, 8) via [(96, 30)]
let backCenterVein2 : sketch = stroke from (102, 50) to (105, 8) via [(104, 30)]

trace [backCenterVein1, backCenterVein2]

# ─────────────────────────────────────────────────────────────────
# FRONT PETALS (overlapping, more detail)
# ─────────────────────────────────────────────────────────────────

# Front Left Petal - dramatic curve
