# -----------------------------------------------------------------------------
# SECTION: ROSE WINDOW
# Description: The magnificent central rose window, approximately 10m in
# diameter. Circular form with radiating tracery lines suggesting the
# intricate Gothic stonework and stained glass patterns. The rose window
# is the heart of the west facade, featuring elaborate stone tracery
# dividing the circle into petal-like segments filled with stained glass.
# -----------------------------------------------------------------------------

let rose_center : vec = (100, 115)
let rose_radius : number = 18

# ===================
# OUTER STONE BORDER
# ===================
# Heavy outer ring - the primary circular frame
# Using 8 curved segments for smoother approximation

draw stroke from (82, 115) to (87, 102) via [(82, 108)]
draw stroke from (87, 102) to (100, 97) via [(93, 97)]
draw stroke from (100, 97) to (113, 102) via [(107, 97)]
draw stroke from (113, 102) to (118, 115) via [(118, 108)]
draw stroke from (118, 115) to (113, 128) via [(118, 122)]
draw stroke from (113, 128) to (100, 133) via [(107, 133)]
draw stroke from (100, 133) to (87, 128) via [(93, 133)]
draw stroke from (87, 128) to (82, 115) via [(82, 122)]

# Inner border ring - creates depth to stone frame
let inner_border_radius : number = 16

draw stroke from (84, 115) to (88, 103) via [(84, 109)]
draw stroke from (88, 103) to (100, 99) via [(94, 99)]
draw stroke from (100, 99) to (112, 103) via [(106, 99)]
