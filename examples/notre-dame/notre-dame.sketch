# ==========================================
#  Notre-Dame de Paris
#  West Facade — viewed from Parvis
#  Canvas: 420 x 297mm (A3 landscape)
# ==========================================


# ------------------------------------------
#  Ground and plaza
# ------------------------------------------

draw stroke -> [(0, 50), (420, 50)]

# Cobblestone texture
scribble dash [
  (40,45), (60,43), (80,46), (100,44), (120,45), (140,43),
  (160,46), (180,44), (200,45), (220,43), (240,46), (260,44),
  (280,45), (300,43), (320,46), (340,44), (360,45), (380,43),
  (50,38), (70,40), (90,37), (110,39), (130,38), (150,40),
  (170,37), (190,39), (210,38), (230,40), (250,37), (270,39),
  (290,38), (310,40), (330,37), (350,39), (370,38), (390,40)
]


# ------------------------------------------
#  Base platform
# ------------------------------------------

trace stroke -> [(130, 50), (130, 55), (290, 55), (290, 50)]
draw stroke -> [(125, 50), (125, 53), (295, 53), (295, 50)]


# ------------------------------------------
#  Three portals
# ------------------------------------------

# Portal template — pointed Gothic arch
let portal_arch = stroke ~> [
  (0, 0), (-1, 12), (0, 22), (5, 28), (10, 30),
  (15, 28), (20, 22), (21, 12), (20, 0)
]

let portal_door = stroke -> [(2, 0), (2, 18), (18, 18), (18, 0)]

let portal_tympanum = stroke ~> [
  (2, 18), (5, 24), (10, 26), (15, 24), (18, 18)
]

let portal = [portal_arch, portal_door, portal_tympanum]

# Center portal — largest
trace portal |> scale 1.6 |> at (210, 87)

# Side portals
trace portal |> at (165, 75)
trace portal |> at (255, 75)

# Portal shading
scribble shade portal |> scale 1.6 |> at (210, 87)
scribble shade portal |> at (165, 75)
scribble shade portal |> at (255, 75)

# Archivolts — layered arches around center portal
draw stroke ~> [
  (192, 55), (190, 75), (195, 95), (210, 103),
  (225, 95), (230, 75), (228, 55)
]
draw stroke ~> [
  (189, 55), (187, 77), (193, 99), (210, 107),
  (227, 99), (233, 77), (231, 55)
]


# ------------------------------------------
#  Gallery of Kings
# ------------------------------------------

trace stroke -> [(135, 115), (285, 115)]
trace stroke -> [(135, 130), (285, 130)]

# Niches with figures
let niche = [
  stroke -> [(0, 0), (0, 13), (3, 15), (6, 13), (6, 0)],
  stroke -> [(2, 2), (2, 10), (4, 10), (4, 2)]
]

draw [
  niche |> at (143, 115),
  niche |> at (155, 115),
  niche |> at (167, 115),
  niche |> at (179, 115),
  niche |> at (191, 115),
  niche |> at (203, 115),
  niche |> at (215, 115),
  niche |> at (227, 115),
  niche |> at (239, 115),
  niche |> at (251, 115),
  niche |> at (263, 115),
  niche |> at (275, 115)
]


# ------------------------------------------
#  Rose window
# ------------------------------------------

let rose_center = (210, 162)
let r = 22

# Outer circle
trace stroke ~> [
  rose_center + (r, 0),
  rose_center + (15, 15),
  rose_center + (0, r),
  rose_center + (-15, 15),
  rose_center + (-r, 0),
  rose_center + (-15, -15),
  rose_center + (0, -r),
  rose_center + (15, -15),
  rose_center + (r, 0)
]

# Inner circle
draw stroke ~> [
  rose_center + (14, 0),
  rose_center + (10, 10),
  rose_center + (0, 14),
  rose_center + (-10, 10),
  rose_center + (-14, 0),
  rose_center + (-10, -10),
  rose_center + (0, -14),
  rose_center + (10, -10),
  rose_center + (14, 0)
]

# Spokes
let diameter = stroke -> [(-r, 0), (r, 0)]

draw [
  diameter,
  diameter |> rotate 30,
  diameter |> rotate 60,
  diameter |> rotate 90,
  diameter |> rotate 120,
  diameter |> rotate 150
] |> at rose_center

# Trefoils between spokes
let trefoil = stroke ~> [
  (0, 0), (2, 3), (0, 5), (-2, 3)
]

draw [
  trefoil |> scale 0.8 |> at (rose_center + (18, 5)),
  trefoil |> scale 0.8 |> rotate 30 |> at (rose_center + (14, 13)),
  trefoil |> scale 0.8 |> rotate 60 |> at (rose_center + (5, 18)),
  trefoil |> scale 0.8 |> rotate 90 |> at (rose_center + (-5, 18)),
  trefoil |> scale 0.8 |> rotate 120 |> at (rose_center + (-14, 13)),
  trefoil |> scale 0.8 |> rotate 150 |> at (rose_center + (-18, 5)),
  trefoil |> scale 0.8 |> rotate 180 |> at (rose_center + (-18, -5)),
  trefoil |> scale 0.8 |> rotate 210 |> at (rose_center + (-14, -13)),
  trefoil |> scale 0.8 |> rotate 240 |> at (rose_center + (-5, -18)),
  trefoil |> scale 0.8 |> rotate 270 |> at (rose_center + (5, -18)),
  trefoil |> scale 0.8 |> rotate 300 |> at (rose_center + (14, -13)),
  trefoil |> scale 0.8 |> rotate 330 |> at (rose_center + (18, -5))
]

# Rose window frame
trace stroke ~> [
  (185, 138), (183, 150), (184, 165), (188, 180),
  (198, 186), (210, 188), (222, 186), (232, 180),
  (236, 165), (237, 150), (235, 138)
]


# ------------------------------------------
#  Side windows — tall lancets
# ------------------------------------------

let lancet = [
  stroke -> [(0, 0), (0, 35)],
  stroke -> [(8, 0), (8, 35)],
  stroke ~> [(0, 35), (4, 42), (8, 35)]
]

let lancet_shaded = [lancet, shade lancet]

draw [
  lancet_shaded |> at (143, 140),
  lancet_shaded |> at (155, 140),
  lancet_shaded |> at (260, 140),
  lancet_shaded |> at (272, 140)
]


# ------------------------------------------
#  Balustrade above rose window
# ------------------------------------------

trace stroke -> [(135, 192), (285, 192)]
trace stroke -> [(135, 196), (285, 196)]

# Baluster posts
let baluster = stroke -> [(0, 0), (0, 4)]

draw [
  baluster |> at (140, 192), baluster |> at (148, 192),
  baluster |> at (156, 192), baluster |> at (164, 192),
  baluster |> at (172, 192), baluster |> at (180, 192),
  baluster |> at (188, 192), baluster |> at (196, 192),
  baluster |> at (204, 192), baluster |> at (212, 192),
  baluster |> at (220, 192), baluster |> at (228, 192),
  baluster |> at (236, 192), baluster |> at (244, 192),
  baluster |> at (252, 192), baluster |> at (260, 192),
  baluster |> at (268, 192), baluster |> at (276, 192)
]


# ------------------------------------------
#  Twin towers
# ------------------------------------------

# Left tower
trace stroke -> [
  (135, 196), (135, 270), (175, 270), (175, 196)
]

# Right tower
trace stroke -> [
  (245, 196), (245, 270), (285, 270), (285, 196)
]

# Tower windows — paired lancets
let tower_lancet = [
  stroke -> [(0, 0), (0, 28)],
  stroke -> [(6, 0), (6, 28)],
  stroke ~> [(0, 28), (3, 33), (6, 28)]
]

let tower_lancet_shaded = [tower_lancet, shade tower_lancet]

# Left tower windows
draw [
  tower_lancet_shaded |> at (140, 210),
  tower_lancet_shaded |> at (150, 210),
  tower_lancet_shaded |> at (160, 210),
  tower_lancet_shaded |> at (140, 245),
  tower_lancet_shaded |> at (150, 245),
  tower_lancet_shaded |> at (160, 245)
]

# Right tower windows
draw [
  tower_lancet_shaded |> at (250, 210),
  tower_lancet_shaded |> at (260, 210),
  tower_lancet_shaded |> at (270, 210),
  tower_lancet_shaded |> at (250, 245),
  tower_lancet_shaded |> at (260, 245),
  tower_lancet_shaded |> at (270, 245)
]

# Tower cornices
draw stroke -> [(135, 240), (175, 240)]
draw stroke -> [(245, 240), (285, 240)]

# Tower top crenellations
let merlon = stroke -> [(0, 0), (0, 5), (5, 5), (5, 0)]

draw [
  merlon |> at (135, 270), merlon |> at (143, 270),
  merlon |> at (151, 270), merlon |> at (159, 270),
  merlon |> at (167, 270)
]

draw [
  merlon |> at (245, 270), merlon |> at (253, 270),
  merlon |> at (261, 270), merlon |> at (269, 270),
  merlon |> at (277, 270)
]


# ------------------------------------------
#  Spire (restored)
# ------------------------------------------

trace stroke -> [(200, 192), (200, 220), (220, 220), (220, 192)]

# Spire rising from crossing
trace stroke ~> [(200, 220), (205, 240), (210, 260), (215, 240), (220, 220)]

# Spire tip
trace stroke -> [(210, 260), (210, 280)]
draw dot (210, 281)

# Spire cross
draw [
  stroke -> [(207, 277), (213, 277)],
  stroke -> [(210, 274), (210, 281)]
]

# Spire dormers
let dormer = stroke ~> [(0, 0), (3, 6), (6, 0)]

draw [
  dormer |> at (203, 225),
  dormer |> at (211, 225)
]


# ------------------------------------------
#  Flying buttresses — left side
# ------------------------------------------

let buttress_arm = stroke ~> [(0, 0), (10, 8), (25, 12)]
let buttress_pier = stroke -> [(0, 0), (0, 60)]

draw [
  buttress_arm |> at (110, 130),
  buttress_pier |> at (108, 50),
  buttress_arm |> at (95, 155),
  buttress_pier |> at (93, 50)
]

# ------------------------------------------
#  Flying buttresses — right side
# ------------------------------------------

let buttress_arm_r = stroke ~> [(0, 0), (-10, 8), (-25, 12)]

draw [
  buttress_arm_r |> at (310, 130),
  buttress_pier |> at (312, 50),
  buttress_arm_r |> at (325, 155),
  buttress_pier |> at (327, 50)
]


# ------------------------------------------
#  Side wall detail
# ------------------------------------------

# Left nave wall
draw stroke -> [(110, 50), (110, 160), (135, 160)]
draw stroke -> [(93, 50), (93, 175), (135, 175)]

# Right nave wall
draw stroke -> [(310, 50), (310, 160), (285, 160)]
draw stroke -> [(327, 50), (327, 175), (285, 175)]

# Side wall windows
let side_window = [
  stroke -> [(0, 0), (0, 20)],
  stroke -> [(5, 0), (5, 20)],
  stroke ~> [(0, 20), (2.5, 25), (5, 20)]
]

draw [
  side_window |> at (100, 80),
  side_window |> at (100, 115),
  side_window |> at (315, 80),
  side_window |> at (315, 115)
]


# ------------------------------------------
#  Gargoyles
# ------------------------------------------

let gargoyle = stroke ~> [(0, 0), (-4, 2), (-8, 1), (-10, -2)]

draw [
  gargoyle |> at (135, 195),
  gargoyle |> mirror y_axis |> translate (150, 0) |> at (285, 195)
]


# ------------------------------------------
#  Facade surface texture
# ------------------------------------------

# Horizontal stone course lines
scribble [
  stroke -> [(136, 108), (284, 108)],
  stroke -> [(136, 135), (284, 135)],
  stroke -> [(136, 188), (284, 188)]
]

# Stone block texture on towers
scribble dash [
  (140, 200), (150, 202), (160, 201), (170, 200),
  (140, 215), (155, 217), (165, 216),
  (140, 230), (150, 232), (160, 231), (170, 230),
  (140, 255), (150, 257), (160, 256), (170, 255),
  (250, 200), (260, 202), (270, 201), (280, 200),
  (250, 215), (265, 217), (275, 216),
  (250, 230), (260, 232), (270, 231), (280, 230),
  (250, 255), (260, 257), (270, 256), (280, 255)
]


# ------------------------------------------
#  Trees flanking the cathedral
# ------------------------------------------

let tree_trunk = stroke ~> [(0, 0), (1, 15), (-1, 30)]

let canopy = stroke ~> [
  (-12, 0), (-10, 10), (-5, 16), (0, 18),
  (5, 16), (10, 10), (12, 0)
]

let tree = [tree_trunk, canopy |> translate (0, 28)]

draw [
  tree |> at (60, 50),
  tree |> scale 0.8 |> at (75, 50),
  tree |> at (355, 50),
  tree |> scale 0.8 |> at (345, 50)
]

scribble [
  shade canopy |> translate (0, 28) |> at (60, 50),
  shade canopy |> translate (0, 28) |> scale 0.8 |> at (75, 50),
  shade canopy |> translate (0, 28) |> at (355, 50),
  shade canopy |> translate (0, 28) |> scale 0.8 |> at (345, 50)
]


# ------------------------------------------
#  Sky and birds
# ------------------------------------------

let wing = stroke ~> [(0, 0), (3, 4), (7, 5)]
let bird = [wing, wing |> mirror y_axis |> translate (7, 0)]

draw [
  bird |> at (50, 260),
  bird |> scale 0.8 |> at (62, 255),
  bird |> scale 0.7 |> at (55, 250),
  bird |> at (365, 265),
  bird |> scale 0.9 |> at (375, 258)
]

# Clouds
scribble [
  stroke ~> [(20, 280), (40, 286), (65, 288), (85, 284), (100, 280)],
  stroke ~> [(330, 285), (350, 290), (375, 292), (395, 288), (410, 284)]
]


# ------------------------------------------
#  Seine in foreground
# ------------------------------------------

scribble [
  stroke ~> [(0, 25), (80, 28), (160, 24), (260, 27), (340, 23), (420, 26)],
  stroke ~> [(0, 15), (90, 18), (180, 13), (270, 17), (360, 14), (420, 16)]
]

# Water texture
scribble dash [
  (30, 20), (70, 22), (110, 19), (150, 21), (190, 18),
  (230, 22), (270, 20), (310, 21), (350, 19), (390, 22),
  (50, 12), (90, 10), (130, 13), (170, 11), (210, 14),
  (250, 10), (290, 13), (330, 11), (370, 14), (410, 10)
]
